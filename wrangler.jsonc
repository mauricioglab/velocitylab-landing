{
  // Despliegue de velocitylab.com.ar en Cloudflare (Workers con assets estáticos).
  // El build es `npm run build` y se publica la carpeta dist/.
  "name": "velocitylab-landing",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
