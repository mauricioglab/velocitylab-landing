---
import { COMPANY_ORIGIN } from '../../data/site';
import { getSiteNav } from '../../data/site-nav';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
  canonical: string;
  type?: 'website' | 'profile';
}

const { title, description, lang, canonical, type = 'website' } = Astro.props;

const origin = COMPANY_ORIGIN;
const siteName = getSiteNav(lang).brand.name;

// Páginas bilingües (/es/… y /en/…): declarar la alternativa en el otro idioma.
const path = Astro.url.pathname;
const bilingual = /^\/(es|en)\//.test(path);
const alternates = bilingual
  ? (['es', 'en'] as const).map((l) => ({ lang: l, href: `${origin}${path.replace(/^\/(es|en)\//, `/${l}/`)}` }))
  : [];

// Imagen para compartir: logo oficial.
const ogImage = `${COMPANY_ORIGIN}/logo-vl-full.png`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: `${COMPANY_ORIGIN}/`,
  logo: `${COMPANY_ORIGIN}/logo-vl-icon.svg`,
  address: { '@type': 'PostalAddress', addressLocality: 'Córdoba', addressCountry: 'AR' },
};
---

<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
{alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
